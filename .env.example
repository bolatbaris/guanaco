# Copy this file to .env and export it before starting the API.
# The API reads VIKUNJA_* environment variables; it does not read this file automatically.

# Required when auth.singleuser.enabled is true.
VIKUNJA_AUTH_SINGLEUSER_ENABLED=true
VIKUNJA_AUTH_SINGLEUSER_USERNAME=admin
VIKUNJA_AUTH_SINGLEUSER_PASSWORD=change-me
VIKUNJA_AUTH_SINGLEUSER_EMAIL=admin@example.com
VIKUNJA_AUTH_SINGLEUSER_NAME=Administrator

# Keep JWTs valid across API restarts in local development.
VIKUNJA_SERVICE_SECRET=replace-with-a-long-random-secret

# Keep only local authentication enabled for this deployment.
VIKUNJA_AUTH_LOCAL_ENABLED=true
VIKUNJA_AUTH_LDAP_ENABLED=false
VIKUNJA_AUTH_OPENID_ENABLED=false

# The frontend dev server can proxy API requests, so CORS is off by default.
VIKUNJA_CORS_ENABLE=false
VIKUNJA_SERVICE_PUBLICURL=http://localhost:3456

# Local development defaults. Change these when using an external database or
# service.
VIKUNJA_DATABASE_TYPE=sqlite
VIKUNJA_DATABASE_PATH=./vikunja.db
VIKUNJA_MAILER_ENABLED=false
VIKUNJA_REDIS_ENABLED=false
