# (1) Duplicate this file and remove the '.example' suffix.
# Naming this file '.env.local' is a Vite convention to prevent accidentally
# submitting to git.
# For more info see: https://vitejs.dev/guide/env-and-mode.html#env-files

# (2) Comment in and adjust the values as needed.

# VITE_IS_ONLINE=true
# Optional local-only GlitchTip browser event verification.
# The DSN is a public ingest identifier; keep deployment-specific values in
# this ignored file and use the backend runtime settings for the combined app.
# VITE_SENTRY_ENABLED=true
# VITE_SENTRY_DSN=https://<frontend-public-key>@glitchtip.example.com/<frontend-project-id>
# VITE_SENTRY_ENVIRONMENT=local
# VITE_SENTRY_TRACES_SAMPLE_RATE=1
# SENTRY_AUTH_TOKEN=YOUR_TOKEN
# SENTRY_ORG=vikunja
# SENTRY_PROJECT=frontend-oss
# VIKUNJA_FRONTEND_BASE=/custom-subpath

# Point the Vite dev server at the local API.
DEV_PROXY=http://localhost:3456
